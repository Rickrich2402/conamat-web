# ══════════════════════════════════════════
# CONAMAT — Protección de directorios
# ══════════════════════════════════════════

# Bloquear acceso directo a carpetas sensibles
# (el JS verifica auth, pero esto añade capa extra)

# No mostrar listado de directorios
Options -Indexes

# Redirigir admin/, profesor/, alumno/ sin sesión
# (solo aplica si usas Apache/Hostinger, no GitHub Pages)

# Proteger archivos de configuración
<FilesMatch "(firebase-config\.js|\.env|\.git)">
  Order allow,deny
  Deny from all
</FilesMatch>

# Headers de seguridad
<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=()"
</IfModule>
